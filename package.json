{
  "name": "microboard-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "mcp"
  ],
  "scripts": {
    "dev": "bun run --cwd mcp dev",
    "build": "bun run --cwd mcp build",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test packages/core/tests mcp/tests",
    "lint": "oxlint packages mcp",
    "mcp": "bun run --cwd mcp start"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^24.13.3",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2"
  }
}
